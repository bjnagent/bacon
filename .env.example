# --- Anthropic (SERVER ONLY — never expose to browser) ---
ANTHROPIC_API_KEY=sk-ant-...
# Leave both UNSET to use the defaults in lib/anthropic.ts. Setting one pins it:
# a stale value here silently wins over a newer code default (that is how every
# call kept metering as claude-sonnet-4-6 after the default moved on).
#
# User-facing work (analyze, chat, debate, personas). Code default: claude-sonnet-5-5
# BACON_MODEL=claude-sonnet-5-5
# Bulk background work (nightly brief, kill-condition watch, Claude fallback for
# the cheap tier). Code default: claude-haiku-5-5
# BACON_BULK_MODEL=claude-haiku-5-5

# --- Gemini (SERVER ONLY) — optional cheaper tier for background bulk work ---
# When set, the nightly sweep's mover/theme scouts, news paraphrasing, and
# tracked-name updates run on Gemini (far cheaper per token, grounded with
# Google Search), with AUTOMATIC fallback to Claude on any error or empty reply.
# User-facing surfaces (morning brief, six-lens analysis, chat) always stay on
# Claude. Leave unset to run everything on Claude as before.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cheapest capable default; use gemini-2.5-flash-lite for maximum savings.
GEMINI_MODEL=gemini-2.5-flash

# --- Grok / xAI (SERVER ONLY) — optional community pulse via live X search ---
# When set, bacon pulls what the investing community is actually saying (X/
# fintwit) into the brief, analysis, property sentiment AND the assessment loop:
# every call is stamped hot/warm/quiet at call time so calibration can measure
# how calls perform when the crowd is loud. Unset = feature quietly off.
XAI_API_KEY=
# XAI_MODEL=grok-3-mini

# --- Supabase ---
# These NEXT_PUBLIC_ values are safe to expose (anon key, not service role)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: SERVER ONLY — used by cron jobs and admin routes ONLY
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Market data (SERVER ONLY) — real movers for the background sweep ---
# The ONLY source of real-time numbers (Bacon never fabricates prices).
# Default provider: Alpha Vantage (free key: https://www.alphavantage.co/support/#api-key)
MARKET_DATA_API_KEY=
# MARKET_DATA_PROVIDER=alphavantage

# Macro backdrop (rates, yield curve, CPI, unemployment, VIX, broad USD index)
# AND the commodity/FX signal feeds (WTI, Brent, nat gas, copper; EUR/USD,
# GBP/USD, USD/JPY) — all via FRED. These commodity/FX levels also price
# Commodity/FX opportunities in the track record's $10K view.
# Free key: https://fredaccount.stlouisfed.org/apikeys . Optional — the macro
# strip and the commodity/FX signals just hide themselves if unset.
FRED_API_KEY=

# Insider-filing clusters via SEC EDGAR (free, no key). SEC's fair-use policy
# asks requesters to identify themselves; set a contact email for the
# User-Agent header. Optional — a generic identifier is used if unset.
# SEC_CONTACT_EMAIL=you@yourdomain.com

# Property tracker (SG + AU) — all sources are FREE and keyless beyond the FRED
# key above (BIS country indices ride FRED). The granular sources are public:
# data.gov.sg (HDB resale price index, URA private residential price index) and
# the ABS data API (mean dwelling price by state). Dataset ids/dataflows are
# best-known defaults; override here if they rotate (find them by searching
# data.gov.sg for the dataset name, or the ABS Data Explorer for TVD).
# DATAGOV_SG_HDB_RPI_ID=
# DATAGOV_SG_URA_PPI_ID=
# ABS_TVD_FLOW=ABS,TVD,1.0.0

# Morning-brief email (optional) — Resend key (free tier: resend.com).
# Without it the email toggle saves but delivery is skipped.
RESEND_API_KEY=
# BRIEF_EMAIL_FROM="Bacon <you@yourdomain.com>"   # defaults to Resend's test sender

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the Account screen and by /api/health (which falls back to the
# deploy's git sha on Vercel). Bump with each App Store release.
NEXT_PUBLIC_APP_VERSION=1.0.0
# Protects /api/cron/*. Vercel auto-sends it as a Bearer token to cron routes.
# Generate with: openssl rand -hex 32
CRON_SECRET=<generate with: openssl rand -hex 32>

# --- House record (public /record) — SERVER ONLY, never NEXT_PUBLIC_ ---
# auth.users.id of the account whose graded calls are published, without a
# login, at /record. This is the proof behind "it grades its own calls": every
# other account's record is RLS-private and empty for its first month, so a
# prospect has nothing to look at until this exists.
#
# Point it at a dedicated account you create for the purpose — NOT your personal
# one. Its calls become public. Unset means /record says the record isn't live
# yet; it never falls back to another account.
#
# Setup: create the account, sign in as it once, then paste its id here. The
# nightly sweep always runs for this account — whatever its plan, and daily
# even if its Auto-sweep toggle is off — because its brief is also the shared
# "house brief" free members read. Its calls are graded by the same nightly
# pass as everyone else's. It can't be deleted from the app's account sheet.
HOUSE_USER_ID=

# --- Operator console (/admin) — SERVER ONLY, never NEXT_PUBLIC_ ---
# Comma-separated emails allowed into the admin console at /admin (user
# behaviour + AI token/cost metering). Fail-CLOSED: unset means nobody has
# access and the route 404s for everyone, including you.
ADMIN_EMAILS=

# Optional rate overrides for the non-Anthropic providers, "INPUT/OUTPUT" in USD
# per 1M tokens, so pricing can be corrected without a deploy. Anthropic rates
# are built in. A model with no rate card is still metered for tokens, but its
# events are marked unpriced rather than counted as $0.
# GEMINI_RATE=0.3/2.5
# XAI_RATE=0.3/0.5

# --- Billing (SERVER ONLY unless prefixed NEXT_PUBLIC_) ---
# Web plans are sold with Stripe Checkout; App Store plans through RevenueCat.
# Both providers' webhooks write the same `subscriptions` row (see lib/billing.ts
# for which one wins when someone pays on both). Until the Stripe keys are set,
# /api/billing/checkout and /portal answer 503 "Billing isn't configured yet."
#
# TEST vs LIVE: Stripe keys, price ids and webhook secrets all come in a test
# and a live flavour that never mix — sk_test_/price ids made in test mode/the
# test-mode endpoint's whsec_ for preview + local, the live set for production.
#
# Secret key — Dashboard → Developers → API keys (sk_test_… / sk_live_…). A
# restricted key works too: Checkout Sessions, Customer portal, Subscriptions
# (write), Prices (read).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at
#   https://<your-domain>/api/billing/webhook
# Dashboard → Developers → Webhooks → (endpoint) → Signing secret (whsec_…).
# Events to send: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_failed. Locally: `stripe listen --forward-to
# localhost:3000/api/billing/webhook` prints a whsec_ for this variable.
STRIPE_WEBHOOK_SECRET=
# Recurring price ids (price_…) — Dashboard → Product catalog → (product) →
# Pricing. One product per plan (Pro, Desk), each with a monthly and a yearly
# price matching lib/plans.ts ($19.99 / $179.99 and $49.99 / $449.99).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_DESK_MONTHLY=
STRIPE_PRICE_DESK_YEARLY=
# 1 = Stripe Tax computes sales tax / VAT at checkout (needs Stripe Tax set up
# with your registrations: Dashboard → Tax). Unset = no tax collected.
# STRIPE_AUTOMATIC_TAX=1
#
# RevenueCat (App Store). Project → Integrations → Webhooks → add
#   https://<your-domain>/api/billing/revenuecat
# and set its "Authorization header value" to a long random string — the same
# string goes here (generate with: openssl rand -hex 32). The route accepts the
# bare value or "Bearer <value>". Sandbox and production events share the
# endpoint; RevenueCat labels each and both are honoured (App Review purchases
# in the sandbox against the production build).
REVENUECAT_WEBHOOK_AUTH=
# Set to 0 to ignore SANDBOX events (also makes TestFlight purchases unlock nothing).
# REVENUECAT_ACCEPT_SANDBOX=1
# App Store product ids → plans. Defaults to bacon_pro_monthly, bacon_pro_yearly,
# bacon_desk_monthly, bacon_desk_yearly; JSON here adds/overrides entries:
# REVENUECAT_PRODUCT_MAP={"com.example.bacon.pro.m":"pro:month","com.example.bacon.desk.y":{"plan":"desk","interval":"year"}}
# Public SDK key for the iOS app (Project → API keys → App Store app, appl_…).
# Public by design — it can only read the signed-in customer's own purchases.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=

# --- iOS app ---
# APNs (push). Apple Developer → Certificates, IDs & Profiles → Keys → create a
# key with "Apple Push Notifications service (APNs)"; download the .p8 once.
APNS_KEY_ID=
# Membership details → Team ID (10 characters).
APNS_TEAM_ID=
# The app's bundle identifier — the APNs topic. Must equal the Capacitor appId
# (CAP_APP_ID, default app.bacon.research).
APNS_BUNDLE_ID=
# Contents of the .p8 file, on ONE line with newlines escaped as \n:
#   "-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APNS_PRIVATE_KEY=
# Optional FALLBACK gateway (production | sandbox) for tokens registered without
# an environment. Each device token stores its own environment (Xcode builds
# register as sandbox, TestFlight/App Store as production) and that always wins.
# APNS_ENV=
# Team ID used in /.well-known/apple-app-site-association (universal links,
# password autofill). Usually the same as APNS_TEAM_ID.
APPLE_TEAM_ID=
# The App Store listing, for "Get the app" links (https://apps.apple.com/app/id…).
NEXT_PUBLIC_APP_STORE_URL=
# The site the iOS shell loads (Capacitor server.url). Read on YOUR machine by
# `npx cap sync ios` and baked into the build — not a server variable. Defaults
# to the production deployment (capacitor.config.ts); point it at a LAN address
# (http://192.168.x.x:3000) to run the simulator against a local dev server.
CAP_SERVER_URL=
